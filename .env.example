# Credenciales OAuth del Copernicus Data Space Ecosystem (Sentinel Hub).
# Copiar este archivo como `.env` y rellenar con los valores propios.
# El archivo `.env` está en .gitignore y nunca debe subirse al repositorio.
#
# Cómo obtenerlas:
#   1. Crear cuenta gratuita en https://dataspace.copernicus.eu
#   2. Entrar a https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
#   3. Sección "OAuth clients" -> "Create OAuth client"
#   4. Copiar el Client ID y el Client Secret (el secret solo se muestra una vez)

SH_CLIENT_ID=
SH_CLIENT_SECRET=
